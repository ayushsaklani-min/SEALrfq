# ─── DATABASE ────────────────────────────────────────────────────────────────
# Use PostgreSQL in production. SQLite only for local dev.
DATABASE_URL="postgresql://user:password@localhost:5432/sealrfq"
# DATABASE_URL="file:./dev.db"   # local SQLite fallback

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-strong-secret-min-32-chars"
ACCESS_TOKEN_TTL=900        # 15 minutes
REFRESH_TOKEN_TTL=604800    # 7 days

# ─── ENVIRONMENT ──────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── ALEO CONTRACT ────────────────────────────────────────────────────────────
#
# Primary RFQ settlement program
# Related auction programs:
#   sealvickrey_v2.aleo
#   sealdutch_v4.aleo
# Stablecoin settlement programs:
#   test_usdcx_stablecoin.aleo
#   test_usad_stablecoin.aleo
ALEO_PROGRAM_ID=sealrfq_v18.aleo
ALEO_INVOICE_PROGRAM_ID=sealrfq_invoice_v1.aleo
ALEO_VICKREY_PROGRAM_ID=sealvickrey_v2.aleo
ALEO_DUTCH_PROGRAM_ID=sealdutch_v4.aleo
ALEO_ADMIN_ADDRESS=aleo1youradminaddress
ALEO_NETWORK=testnet
ALEO_RPC_URL=https://api.explorer.provable.com/v1
ALEO_CONSENSUS_VERSION=12

# RPC call timeout in milliseconds (default 10s)
ALEO_RPC_TIMEOUT_MS=10000

# ─── FEE OVERRIDES (optional) ─────────────────────────────────────────────────
# Override fee for any transition (microcredits). Leave unset to use defaults.
# ALEO_FEE_CREATE_RFQ=1500000
# ALEO_FEE_SUBMIT_BID_COMMIT=1000000
# ALEO_DEFAULT_FEE=1000000

# ─── LEO CLI (optional) ───────────────────────────────────────────────────────
# LEO_BIN=leo
# ALEO_PROJECT_DIR=/opt/render/project/src/contracts

# ─── REDIS (required in production for rate limiting) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AUDITOR WHITELIST ────────────────────────────────────────────────────────
# Comma-separated Aleo addresses that receive the AUDITOR role on login.
# Example: AUDITOR_WHITELIST="aleo1abc...xyz,aleo1def...uvw"
AUDITOR_WHITELIST=""
