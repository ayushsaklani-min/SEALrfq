# ─── DATABASE ────────────────────────────────────────────────────────────────
# Use PostgreSQL in production. SQLite only for local dev.
DATABASE_URL="postgresql://user:password@localhost:5432/sealrfq"
# DATABASE_URL="file:./dev.db"   # local SQLite fallback

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-strong-secret-min-32-chars"
ACCESS_TOKEN_TTL=900        # 15 minutes
REFRESH_TOKEN_TTL=604800    # 7 days

# ─── ENVIRONMENT ──────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── ALEO CONTRACT ────────────────────────────────────────────────────────────
#
# TWO deployments — choose based on use case:
#
#   sealrfq_v9.aleo  (DEMO)
#     Short timeouts (10-30 blocks / ~1-2 minutes).
#     Use this for demo video recording — full flow completes in ~6 minutes.
#
#   sealrfq_v10.aleo (PRODUCTION)
#     Market-ready timeouts (720-2880 blocks / 1-4 hours).
#     Use this for production testnet and mainnet deployment.
#
ALEO_PROGRAM_ID=sealrfq_v10.aleo
ALEO_NETWORK=testnet
ALEO_RPC_URL=https://api.explorer.provable.com/v1
ALEO_CONSENSUS_VERSION=12

# RPC call timeout in milliseconds (default 10s)
ALEO_RPC_TIMEOUT_MS=10000

# ─── FEE OVERRIDES (optional) ─────────────────────────────────────────────────
# Override fee for any transition (microcredits). Leave unset to use defaults.
# ALEO_FEE_CREATE_RFQ=1500000
# ALEO_FEE_SUBMIT_BID_COMMIT=1000000
# ALEO_DEFAULT_FEE=1000000

# ─── ALEO TRANSACTION SIGNING KEYS (optional — server-side signing) ──────────
# Only needed when using the Leo CLI executor (backend/aleo/executor.ts).
# Leave unset if transactions are signed client-side by the browser wallet.
# ALEO_BUYER_PRIVATE_KEY=APrivateKey1...
# ALEO_VENDOR_PRIVATE_KEY=APrivateKey1...

# ─── LEO CLI (optional) ───────────────────────────────────────────────────────
# LEO_BIN=leo
# ALEO_PROJECT_DIR=/opt/render/project/src/contracts/v10

# ─── REDIS (required in production for rate limiting) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AUDITOR WHITELIST ────────────────────────────────────────────────────────
# Comma-separated Aleo addresses that receive the AUDITOR role on login.
# Example: AUDITOR_WHITELIST="aleo1abc...xyz,aleo1def...uvw"
AUDITOR_WHITELIST=""
