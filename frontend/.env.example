# ─── ALEO CONTRACT ────────────────────────────────────────────────────────────
#
# TWO deployments — choose based on use case:
#
#   sealrfq_v9.aleo  (DEMO)
#     Short timeouts (~1-2 minutes per phase).
#     Use this when recording demo video — full flow in ~6 minutes.
#
#   sealrfq_v10.aleo (PRODUCTION)
#     Market-ready timeouts (1-4 hours per phase).
#     Use this for production testnet and mainnet deployment.
#
NEXT_PUBLIC_ALEO_PROGRAM_ID=sealrfq_v10.aleo
NEXT_PUBLIC_ALEO_NETWORK=testnet

# ─── BACKEND ──────────────────────────────────────────────────────────────────
# Server-side only — used by frontend API proxy routes.
BACKEND_API_URL=https://your-backend.render.com
# BACKEND_API_URL=http://localhost:4000   # local dev
